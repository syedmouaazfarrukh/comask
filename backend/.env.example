# Colorado Energy Compliance Assistant - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Colorado Energy Compliance Assistant"
APP_ENV=development  # development, staging, production
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production  # Generate with: openssl rand -hex 32

# =============================================================================
# DATABASE (PostgreSQL with pgvector)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://comask:comask_dev_password@localhost:5432/comask
DATABASE_NAME=comask

# Vector embedding dimension (Voyage AI = 1024, OpenAI = 1536/3072)
VECTOR_DIMENSION=1024

# =============================================================================
# LLM PROVIDER (Claude is primary)
# =============================================================================
LLM_PROVIDER=claude  # claude, azure_openai, groq

# Claude API (Anthropic) - PRIMARY
CLAUDE_API_KEY=your-anthropic-api-key
CLAUDE_MODEL_FAST=claude-sonnet-4-20250514
CLAUDE_MODEL_COMPLEX=claude-opus-4-20250514
CLAUDE_MAX_TOKENS=4096

# Azure OpenAI (Fallback)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4-turbo
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Groq (Alternative)
GROQ_API_KEY=
GROQ_MODEL=llama-3-70b-8192

# =============================================================================
# EMBEDDINGS (Voyage AI)
# =============================================================================
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_MODEL=voyage-law-2  # Optimized for legal text
VOYAGE_BATCH_SIZE=128

# =============================================================================
# AUTHENTICATION
# =============================================================================
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# =============================================================================
# SCRAPING
# =============================================================================
SCRAPER_USER_AGENT="Mozilla/5.0 (Colorado Energy Compliance Assistant)"
SCRAPER_DELAY_SECONDS=2.0
SCRAPER_MAX_RETRIES=3

# =============================================================================
# DATA SOURCES
# =============================================================================
# Federal Sources
ECFR_API_BASE_URL=https://www.ecfr.gov/api/versioner/v1
FERC_BASE_URL=https://elibrary.ferc.gov
FEDERAL_REGISTER_API_URL=https://www.federalregister.gov/api/v1

# Colorado Sources
CPUC_BASE_URL=https://puc.colorado.gov
CPUC_EFILINGS_URL=https://www.dora.state.co.us/pls/efi/EFI_Search_UI.search
CRS_BASE_URL=https://leg.colorado.gov/colorado-revised-statutes
CCR_BASE_URL=https://www.sos.state.co.us/CCR
CEO_BASE_URL=https://energyoffice.colorado.gov

# Regional Sources
NERC_STANDARDS_URL=https://www.nerc.com/pa/Stand/Pages/ReliabilityStandards.aspx
WECC_STANDARDS_URL=https://www.wecc.org/Standards
SPP_BASE_URL=https://www.spp.org

# =============================================================================
# REDIS (for caching and task queue)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# STORAGE
# =============================================================================
STORAGE_TYPE=local  # local, s3
STORAGE_PATH=./storage

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
