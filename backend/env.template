# ============================================
# Comask Backend Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp env.template .env

# ============================================
# Application Settings
# ============================================
APP_NAME=Comask
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/comask_db

# ============================================
# Vector Database
# ============================================
# Options: 'chroma' or 'pgvector'
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_db
VECTOR_DIMENSION=1536

# ============================================
# LLM Provider Configuration
# ============================================
# Options: 'azure_openai' or 'groq'
LLM_PROVIDER=azure_openai

# ============================================
# Azure OpenAI Configuration
# ============================================
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4-turbo

# ============================================
# Groq Configuration (Future Use)
# ============================================
# Uncomment and configure when switching to Groq
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3-70b-8192

# ============================================
# Embedding Model Configuration
# ============================================
# Azure OpenAI Embedding Deployment Name
# IMPORTANT: This must be a deployment name in your Azure OpenAI resource, not a model name
# If you don't have an embedding deployment, create one in Azure Portal:
# 1. Go to your Azure OpenAI resource
# 2. Navigate to "Deployments" or "Model deployments"
# 3. Create a new deployment for "text-embedding-3-large" or "text-embedding-ada-002"
# 4. Use that deployment name here
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# ============================================
# Scraper Configuration
# ============================================
SCRAPER_USER_AGENT=Mozilla/5.0 (Comask Scraper Bot)
SCRAPER_DELAY_SECONDS=2.0
SCRAPER_MAX_RETRIES=3

# ============================================
# Colorado Data Sources
# ============================================
CPUC_BASE_URL=https://puc.colorado.gov
CEO_BASE_URL=https://energyoffice.colorado.gov
LEGISLATURE_BASE_URL=https://leg.colorado.gov

# ============================================
# Redis Configuration
# ============================================
# For caching and task queue (optional for MVP)
REDIS_URL=redis://localhost:6379/0

# ============================================
# File Storage Configuration
# ============================================
# Options: 'local' or 's3'
STORAGE_TYPE=local
STORAGE_PATH=./storage

# AWS S3 Configuration (if using S3)
# AWS_S3_BUCKET=comask-documents
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO

# ============================================
# Notes
# ============================================
# 1. Never commit .env file to git
# 2. Generate a strong SECRET_KEY for production
# 3. Update DATABASE_URL with your PostgreSQL credentials
# 4. Add your Azure OpenAI credentials
# 5. For production, set APP_ENV=production and DEBUG=False

