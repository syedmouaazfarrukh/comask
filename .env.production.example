# Production Environment Variables for Colorado Energy Compliance Assistant
# Copy this file to .env.production and fill in the values

# ============================================
# Database
# ============================================
POSTGRES_USER=comask
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=comask

# ============================================
# Security
# ============================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your_256_bit_secret_key_here

# ============================================
# LLM APIs
# ============================================
CLAUDE_API_KEY=sk-ant-api03-...
VOYAGE_API_KEY=pa-...

# ============================================
# URLs
# ============================================
# Backend URL (for frontend API calls)
BACKEND_URL=https://your-backend-domain.azurewebsites.net

# Frontend URL (for CORS configuration)
FRONTEND_URL=https://your-frontend-domain.azurewebsites.net

# ============================================
# Optional: Azure-specific settings
# ============================================
# AZURE_POSTGRESQL_HOST=your-server.postgres.database.azure.com
# AZURE_POSTGRESQL_USER=comask@your-server
# AZURE_POSTGRESQL_PASSWORD=your_password
# AZURE_POSTGRESQL_DB=comask
